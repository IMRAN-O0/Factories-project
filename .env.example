# Google Analytics 4 — from analytics.google.com, format G-XXXXXXXXXX
# Leave empty locally; nothing loads until this is set.
VITE_GA_MEASUREMENT_ID=

# --- Backend (Vercel serverless functions in /api) ---
# Supabase project (used to store booking/contact submissions and uploaded files)
# Public — safe to expose in the browser bundle, set for the frontend build:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Secret — server-side only, used by the /api functions, never expose to the browser:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (used to email a notification for every new submission)
RESEND_API_KEY=
NOTIFY_EMAIL=info@awalhelm.com
